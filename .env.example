# Porta e host do servidor
PORT=3000
HOST=0.0.0.0

# Domínios autorizados a enviar o formulário (separados por vírgula)
ALLOWED_ORIGINS=https://www.draflaviacurvello.com.br,https://draflaviacurvello.com.br

# Defina 1 apenas se o app rodar atrás de um proxy reverso confiável (Nginx, Render, Railway, Fly...)
TRUST_PROXY=0

# Onde salvar os leads (JSON Lines). Deixe vazio para não gravar em disco.
LEADS_FILE=./data/leads.jsonl

# Opcional: enviar cada lead para uma automação (n8n, Make, Zapier, Google Apps Script). Somente https.
LEAD_WEBHOOK_URL=
# Opcional: segredo para assinar o webhook (cabeçalho X-Signature-SHA256 = HMAC-SHA256 do corpo)
LEAD_WEBHOOK_SECRET=

# Sal para anonimizar IPs (gere com: openssl rand -hex 32)
IP_HASH_SALT=

# Número do WhatsApp da clínica (somente dígitos, com DDI)
WHATSAPP_NUMBER=5548988659104

# Limites de envio do formulário por IP
LEAD_RATE_MAX=5
LEAD_RATE_WINDOW_MS=600000
